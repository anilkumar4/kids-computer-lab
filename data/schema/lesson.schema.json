{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "track", "title", "steps"],
  "properties": {
    "id": { "type": "string" },
    "track": { "type": "string", "enum": ["explorers", "champions"] },
    "grade": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "duration": { "type": "string" },
    "objectives": { "type": "array", "items": { "type": "string" } },
    "prerequisites": { "type": "array", "items": { "type": "string" } },
    "vocabulary": { "type": "array", "items": { "type": "string" } },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["story", "hotspot", "quiz", "sort", "recap", "completion", "mouseGame", "typing"] },
          "boltExpression": { "type": "string" },
          "boltSpeech": { "type": "string" },
          "content": { "type": "object" },
          "hotspots": { "type": "array" },
          "questions": { "type": "array" },
          "items": { "type": "array" },
          "zones": { "type": "array" }
        }
      }
    }
  }
}
